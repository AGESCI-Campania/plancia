# Plancia — variabili di PRODUZIONE.
# scripts/installa.sh copia questo file in .env (chmod 600) e genera i segreti; non
# sovrascrive mai un .env esistente. scripts/aggiorna.sh segnala le variabili aggiunte qui
# e non ancora presenti in .env. Dopo ogni modifica a .env: docker compose up -d
# (ricrea i container; restart non basta).

# --- Django ---------------------------------------------------------------------------
# Generata da installa.sh. Attivare DJANGO_DEBUG solo per diagnosi puntuali.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
ALLOWED_HOSTS=plancia.agescicampania.net
CSRF_TRUSTED_ORIGINS=https://plancia.agescicampania.net
BASE_URL=https://plancia.agescicampania.net

# --- Database (container db) ------------------------------------------------------------
# POSTGRES_PASSWORD generata da installa.sh; DATABASE_URL è composta in docker-compose.yml.
POSTGRES_DB=plancia
POSTGRES_USER=plancia
POSTGRES_PASSWORD=

# --- Redis / Celery (container redis) ---------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_CACHE_URL=redis://redis:6379/2

# --- SSO AGESCI Campania (Sestante) -----------------------------------------------------
# Client ID e Client Secret del provider "Plancia AGESCI Campania", da
# https://auth.agescicampania.net/if/admin/#/core/providers → Plancia AGESCI Campania → modifica.
# Vuoti = pulsante "Accedi con SSO AGESCI Campania" nascosto (resta il login locale).
SOCIAL_SESTANTE_CLIENT_ID=
SOCIAL_SESTANTE_CLIENT_SECRET=

# --- Social login facoltativi (docs/guide/social_auth.md) -------------------------------
# Vuoti = pulsante nascosto. Redirect URI da registrare presso i provider:
#   https://plancia.agescicampania.net/accounts/<google|microsoft|apple>/login/callback/
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
SOCIAL_MICROSOFT_CLIENT_ID=
SOCIAL_MICROSOFT_CLIENT_SECRET=
SOCIAL_APPLE_CLIENT_ID=
SOCIAL_APPLE_TEAM_ID=
SOCIAL_APPLE_KEY_ID=
SOCIAL_APPLE_PRIVATE_KEY=

# --- Google Drive e Gmail SMTP (OAuth, docs/guide/google_drive_oauth.md) -----------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://plancia.agescicampania.net/drive/oauth/callback/
GOOGLE_GMAIL_SMTP_REDIRECT_URI=https://plancia.agescicampania.net/impostazioni/gmail-smtp/oauth/callback/

# --- Email --------------------------------------------------------------------------------
# Provider e credenziali si configurano da Impostazioni; questo SMTP è il fallback per la
# prima configurazione (docs/guide/email_provider.md).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=plancia@agescicampania.net
SERVER_EMAIL=plancia@agescicampania.net
# Notifiche errori 404/500: indirizzi separati da virgola (vuoto = disabilitate)
ADMIN_EMAILS=

# Mailpit (debug email, solo con il profilo "mailpit": vedi COMPOSE_PROFILES sotto)
MAILPIT_SMTP_HOST=mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_INTERNAL_URL=http://mailpit:8025

# --- API REST (CORS) per l'app mobile ---------------------------------------------------
# Origini autorizzate separate da virgola, es. https://app.agescicampania.net
CORS_ALLOWED_ORIGINS=

# --- Backup notturno (scripts/backup.sh, timer plancia-backup.timer) --------------------
# Cartella degli archivi (relativa al repo o assoluta) e giorni di conservazione.
BACKUP_DIR=backups
BACKUP_GIORNI=14

# --- Servizi facoltativi ------------------------------------------------------------------
# Profili compose da avviare insieme allo stack (anche al boot): mailpit, flower.
# COMPOSE_PROFILES=flower
