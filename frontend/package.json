{
  "name": "plancia-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SPA di Plancia (Vue 3 + Bootstrap 6). La versione dell'app è quella di ../pyproject.toml.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "format": "prettier --write src/ e2e/",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "api:tipi": "mkdir -p node_modules/.tmp && cd .. && uv run python manage.py esporta_openapi --output frontend/node_modules/.tmp/openapi.json && cd frontend && openapi-typescript node_modules/.tmp/openapi.json -o src/api/schema.d.ts",
    "icone": "node scripts/genera-icone.mjs",
    "manuale:schermate": "node scripts/schermate-manuale.ts"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@tiptap/starter-kit": "3.34.0",
    "@tiptap/vue-3": "3.34.0",
    "bootstrap": "6.0.0-alpha.1",
    "bootstrap-icons": "1.13.2",
    "dexie": "4.4.7",
    "pinia": "4.1.0",
    "qrcode": "1.5.4",
    "vanilla-calendar-pro": "3.4.0",
    "vue": "3.5.45",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.6.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "fake-indexeddb": "6.2.8",
    "jiti": "2.7.0",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "sass": "1.108.2",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14",
    "workbox-window": "7.4.1"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
