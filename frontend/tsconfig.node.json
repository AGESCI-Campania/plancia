{
  "extends": "@vue/tsconfig/tsconfig.json",
  "include": ["vite.config.ts", "playwright.config.ts", "eslint.config.ts", "e2e/**/*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2024", "DOM"],
    "types": ["node", "vitest/globals"],
    "noEmit": true,
    "paths": { "@/*": ["./src/*"] }
  }
}
